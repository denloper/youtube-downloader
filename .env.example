# Messenger AI — скопируйте в .env и заполните нужные каналы.

COMPANY_NAME=Моя компания
HOST=0.0.0.0
PORT=8080

# Публичный HTTPS-адрес (ngrok / Cloudflare Tunnel), если нужны вебхуки Meta.
# Если пусто, Telegram работает через long polling.
PUBLIC_BASE_URL=

# OpenAI или совместимый API (Groq, OpenRouter, локальный Ollama).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Telegram: бот от @BotFather. OWNER_CHAT_ID — ваш личный chat id (отчёты приходят сюда).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=messenger-ai-telegram

# WhatsApp Cloud API (Meta Business).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_PHONE=

# Instagram Messaging API (профессиональный аккаунт, привязанный к странице Facebook).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_OWNER_IGSID=

# Общие настройки приложения Meta (проверка вебхука и подпись).
META_VERIFY_TOKEN=messenger-ai-verify
META_APP_SECRET=

AUTO_REPLY_ENABLED=true
REPORT_HOUR=20
REPORT_TIMEZONE=Europe/Moscow
